# Copy this file to .env and fill in your own key.
# Use a key dedicated to this project -- separate from any key powering
# other Gemini-backed apps -- so a runaway local test here can never affect
# another app's quota. (litellm reads GEMINI_API_KEY for the gemini/ provider.)
GEMINI_API_KEY=

# Optional: override the default model (litellm "provider/model" format).
# NOOA_MODEL=gemini/gemini-3.5-flash-lite
